# Variables lues par Docker Compose pour interpoler compose.yaml.
# Elles n'entrent dans AUCUN conteneur : pour ca, voir db/.env, api/.env, front/.env.

# Nommage des images (pousse vers GHCR)
REGISTRY=ghcr.io
IMAGE_NAMESPACE=local
# IMAGE_TAG volontairement non defini : le defaut depend du fichier compose
# (dev -> :dev, prod -> :prod). Le fixer ici ecraserait les deux.
# En CI : IMAGE_TAG=$GITHUB_SHA docker compose -f compose.yaml -f compose.prod.yaml build
# IMAGE_TAG=

# Ports publies en dev (lies a 127.0.0.1)
FRONT_PORT=5173
API_PORT=3000
DB_PORT=5432
MAILPIT_PORT=8025
SMTP_PORT=1025

# Port publie en prod
HTTP_PORT=80
